{
  "name": "friday",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "python:test": "python3 -m unittest discover -s src-tauri/python_tests -p 'test_*.py' -v",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "cargo:check": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "cargo:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "cargo:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked -- -D warnings",
    "check": "npm run typecheck && npm run lint && npm run test:run && npm run build && npm run cargo:check && npm run cargo:test",
    "tauri": "LLVM_PROFILE_FILE=/tmp/friday-%p.profraw tauri"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.164",
    "@ant-design/icons": "^6.0.1",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "ai": "^6.0.162",
    "antd": "^5",
    "katex": "^0.16.45",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^9",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.8.3",
    "typescript": "^5.7",
    "typescript-eslint": "^8.60.0",
    "vite": "^6",
    "vitest": "^3.2.4"
  }
}
